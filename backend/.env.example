DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── AI Keys ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Set WHATSAPP_PROVIDER=META_CLOUD to enable real sending. Leave blank for mock.
WHATSAPP_PROVIDER=META_CLOUD

# From Meta Business Manager → System Users → Generate Token
# Required permissions: whatsapp_business_management + whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxx

# From WhatsApp Manager → Phone Numbers → (your number) → copy numeric ID
WHATSAPP_PHONE_NUMBER_ID=1194987650372629

# From WhatsApp Manager → Overview → WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=1428341879273527

# Graph API version — keep at v25.0 unless Meta instructs an upgrade
WHATSAPP_GRAPH_API_VERSION=v25.0

# Name of your default Meta-approved message template for cold outreach
# Must be Active-Qualified in WhatsApp Manager → Message Templates
WHATSAPP_DEFAULT_TEMPLATE_NAME=cold_outreach

# ── WhatsApp Embedded Signup (for GUI connect flow) ───────────────────────────
WHATSAPP_APP_ID=28291286250455039
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_CONFIG_ID=your_embedded_signup_config_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mailflow_verify_token
WHATSAPP_REDIRECT_URI=http://localhost:5173/settings
