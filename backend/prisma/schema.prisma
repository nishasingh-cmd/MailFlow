// MailFlow — Prisma Schema
// Phase 4: Authentication & User Management Data Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  uuid         String   @default(uuid()) @unique
  name         String
  email        String   @unique
  password     String
  avatar       String?
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
