// MailFlow — Prisma Schema
// Phase 9: Email Delivery Engine (SaaS Delivery System)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  uuid          String          @default(uuid()) @unique
  name          String
  email         String          @unique
  password      String
  avatar        String?
  refreshToken  String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  leads         Lead[]
  importHistory ImportHistory[]
  companies     Company[]
  emailDrafts   EmailDraft[]
  campaigns     Campaign[]
  smtpConfig    SmtpConfig?
  emailQueues   EmailQueue[]
  emailLogs     EmailLog[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNSUBSCRIBED
  BOUNCED
}

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Lead {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importHistoryId String?
  importHistory   ImportHistory? @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)
  companyId       String?
  companyRef      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name            String
  email           String
  company         String?
  phone           String?
  website         String?
  linkedin        String?
  industry        String?
  status          LeadStatus     @default(NEW)
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]
  campaignLeads   CampaignLead[]
  emailQueues     EmailQueue[]
  emailLogs       EmailLog[]

  @@unique([userId, email])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, companyId])
}

model ImportHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  totalRows      Int
  importedCount  Int
  failedCount    Int
  duplicateCount Int
  createdAt      DateTime @default(now())
  leads          Lead[]

  @@index([userId, createdAt])
}

model Company {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  website         String?
  industry        String?
  description     String?          @db.Text
  products        String[]
  services        String[]
  headquarters    String?
  companySize     String?
  targetCustomers String?          @db.Text
  techStack       String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  leads           Lead[]
  research        CompanyResearch?

  @@unique([userId, name])
  @@index([userId])
}

model CompanyResearch {
  id             String         @id @default(cuid())
  companyId      String         @unique
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         ResearchStatus @default(PENDING)
  summary        String?        @db.Text
  painPoints     Json?
  opportunities  Json?
  rawAiResponse  String?        @db.Text
  errorMessage   String?
  retryCount     Int            @default(0)
  lastResearched DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]

  @@index([companyId])
  @@index([status])
}

enum DraftStatus {
  DRAFT
  SAVED
  SENT
}

model EmailDraft {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  researchId  String?
  research    CompanyResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  template    String           @default("Cold Outreach")
  subject     String
  body        String           @db.Text
  status      DraftStatus      @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([researchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 8 & 9 — Campaign & Delivery Engine
// ─────────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  READY
  QUEUED
  SENDING
  PAUSED
  SENT
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum QueueJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Campaign {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?          @db.Text
  status        CampaignStatus   @default(DRAFT)
  templateId    String?
  sendingSpeed  String           @default("NORMAL") // FAST | NORMAL | SLOW
  startedAt     DateTime?
  completedAt   DateTime?
  lastSentEmail String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  campaignLeads CampaignLead[]
  emailQueues   EmailQueue[]
  emailLogs     EmailLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model CampaignLead {
  campaignId String
  leadId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
}

model SmtpConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("CUSTOM")
  host        String
  port        Int
  username    String
  password    String   @db.Text
  encryption  String   @default("TLS")
  fromName    String
  fromEmail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model EmailQueue {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  htmlBody       String         @db.Text
  status         QueueJobStatus @default(PENDING)
  attempts       Int            @default(0)
  maxRetries     Int            @default(3)
  messageId      String?
  scheduledAt    DateTime       @default(now())
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  errorMessage   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([campaignId, leadId])
  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
}

model EmailLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  queueId        String?
  recipientEmail String
  subject        String
  status         String   // SENT | FAILED
  provider       String?
  retryCount     Int      @default(0)
  messageId      String?
  errorReason    String?  @db.Text
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}
