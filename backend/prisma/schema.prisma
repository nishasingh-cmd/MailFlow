// MailFlow — Prisma Schema
// Phase 6: AI Company Research

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  uuid          String          @default(uuid()) @unique
  name          String
  email         String          @unique
  password      String
  avatar        String?
  refreshToken  String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  leads         Lead[]
  importHistory ImportHistory[]
  companies     Company[]
  emailDrafts   EmailDraft[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNSUBSCRIBED
  BOUNCED
}

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Lead {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importHistoryId String?
  importHistory   ImportHistory? @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)
  companyId       String?
  companyRef      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name            String
  email           String
  company         String?
  phone           String?
  website         String?
  linkedin        String?
  industry        String?
  status          LeadStatus     @default(NEW)
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]

  @@unique([userId, email])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, companyId])
}

model ImportHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  totalRows      Int
  importedCount  Int
  failedCount    Int
  duplicateCount Int
  createdAt      DateTime @default(now())
  leads          Lead[]

  @@index([userId, createdAt])
}

model Company {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  website         String?
  industry        String?
  description     String?          @db.Text
  products        String[]
  services        String[]
  headquarters    String?
  companySize     String?
  targetCustomers String?          @db.Text
  techStack       String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  leads           Lead[]
  research        CompanyResearch?

  @@unique([userId, name])
  @@index([userId])
}

model CompanyResearch {
  id             String         @id @default(cuid())
  companyId      String         @unique
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         ResearchStatus @default(PENDING)
  summary        String?        @db.Text
  painPoints     Json?
  opportunities  Json?
  rawAiResponse  String?        @db.Text
  errorMessage   String?
  retryCount     Int            @default(0)
  lastResearched DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]

  @@index([companyId])
  @@index([status])
}

enum DraftStatus {
  DRAFT
  SAVED
  SENT
}

model EmailDraft {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  researchId  String?
  research    CompanyResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  template    String           @default("Cold Outreach")
  subject     String
  body        String           @db.Text
  status      DraftStatus      @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([researchId])
}
