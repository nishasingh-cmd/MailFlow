// MailFlow — Prisma Schema
// Phase 12: Settings & Integrations Module

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  uuid          String          @default(uuid()) @unique
  name          String
  email         String          @unique
  password      String
  avatar        String?
  companyName   String?
  jobTitle      String?
  timeZone      String?         @default("UTC")
  refreshToken  String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  leads         Lead[]
  importHistory ImportHistory[]
  companies     Company[]
  emailDrafts   EmailDraft[]
  campaigns     Campaign[]
  smtpConfig    SmtpConfig?
  emailQueues   EmailQueue[]
  emailLogs     EmailLog[]
  whatsappDrafts WhatsappDraft[]
  whatsappQueues WhatsappQueue[]
  whatsappLogs   WhatsappLog[]
  aiConfig       AiConfig?
  whatsappConfig WhatsappConfig?
  appPreferences AppPreferences?
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNSUBSCRIBED
  BOUNCED
}

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Lead {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importHistoryId String?
  importHistory   ImportHistory? @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)
  companyId       String?
  companyRef      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name            String
  email           String
  company         String?
  phone           String?
  website         String?
  linkedin        String?
  industry        String?
  status          LeadStatus     @default(NEW)
  customFields    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]
  campaignLeads   CampaignLead[]
  emailQueues     EmailQueue[]
  emailLogs       EmailLog[]
  whatsappDrafts  WhatsappDraft[]
  whatsappQueues  WhatsappQueue[]
  whatsappLogs    WhatsappLog[]

  @@unique([userId, email])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, companyId])
}

model ImportHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  totalRows      Int
  importedCount  Int
  failedCount    Int
  duplicateCount Int
  createdAt      DateTime @default(now())
  leads          Lead[]

  @@index([userId, createdAt])
}

model Company {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  website         String?
  industry        String?
  description     String?          @db.Text
  products        String[]
  services        String[]
  headquarters    String?
  companySize     String?
  targetCustomers String?          @db.Text
  techStack       String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  leads           Lead[]
  research        CompanyResearch?

  @@unique([userId, name])
  @@index([userId])
}

model CompanyResearch {
  id             String         @id @default(cuid())
  companyId      String         @unique
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         ResearchStatus @default(PENDING)
  summary        String?        @db.Text
  painPoints     Json?
  opportunities  Json?
  rawAiResponse  String?        @db.Text
  errorMessage   String?
  retryCount     Int            @default(0)
  lastResearched DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  emailDrafts     EmailDraft[]

  @@index([companyId])
  @@index([status])
}

enum DraftStatus {
  DRAFT
  SAVED
  SENT
}

model EmailDraft {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  researchId  String?
  research    CompanyResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  template    String           @default("Cold Outreach")
  subject     String
  body        String           @db.Text
  status      DraftStatus      @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([researchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Campaign & Delivery & Settings Engine
// ─────────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  READY
  QUEUED
  SENDING
  PAUSED
  SENT
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
  EMAIL_AND_WHATSAPP
}

enum QueueJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Campaign {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?          @db.Text
  status        CampaignStatus   @default(DRAFT)
  channel       CampaignChannel  @default(EMAIL)
  templateId    String?
  sendingSpeed  String           @default("NORMAL") // FAST | NORMAL | SLOW
  startedAt     DateTime?
  completedAt   DateTime?
  lastSentEmail String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  campaignLeads CampaignLead[]
  emailQueues   EmailQueue[]
  emailLogs     EmailLog[]
  whatsappDrafts WhatsappDraft[]
  whatsappQueues WhatsappQueue[]
  whatsappLogs   WhatsappLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model CampaignLead {
  campaignId String
  leadId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
}

model SmtpConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("CUSTOM")
  host        String
  port        Int
  username    String
  password    String   @db.Text
  encryption  String   @default("TLS")
  fromName    String
  fromEmail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model EmailQueue {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  htmlBody       String         @db.Text
  status         QueueJobStatus @default(PENDING)
  attempts       Int            @default(0)
  maxRetries     Int            @default(3)
  messageId      String?
  scheduledAt    DateTime       @default(now())
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  errorMessage   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([campaignId, leadId])
  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
}

model EmailLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  queueId        String?
  recipientEmail String
  subject        String
  status         String   // SENT | FAILED
  provider       String?
  retryCount     Int      @default(0)
  messageId      String?
  errorReason    String?  @db.Text
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model WhatsappDraft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message     String   @db.Text
  status      String   @default("DRAFT") // DRAFT | QUEUED | SENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([campaignId])
}

model WhatsappQueue {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  phone         String
  message       String         @db.Text
  status        QueueJobStatus @default(PENDING)
  attempts      Int            @default(0)
  maxRetries    Int            @default(3)
  messageId     String?
  scheduledAt   DateTime       @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  lastAttemptAt DateTime?
  errorMessage  String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
}

model WhatsappLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  queueId     String?
  phone       String
  message     String   @db.Text
  status      String   // SENT | DELIVERED | READ | FAILED | CANCELLED
  provider    String   @default("MOCK") // MOCK | TWILIO | META_CLOUD
  retryCount  Int      @default(0)
  messageId   String?
  errorReason String?  @db.Text
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 12 — Settings & Integrations Models
// ─────────────────────────────────────────────────────────────────────────────

model AiConfig {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String    @default("OPENAI") // OPENAI | GEMINI
  apiKey      String    @db.Text // Encrypted
  model       String    @default("gpt-4o-mini")
  temperature Float     @default(0.7)
  maxTokens   Int       @default(1000)
  status      String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | INVALID_KEY | FAILED
  lastTestedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model WhatsappConfig {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    @default("MOCK") // MOCK | META_CLOUD
  businessAccountId String?
  phoneNumberId     String?
  accessToken       String?   @db.Text // Encrypted
  webhookVerifyToken String?
  appSecret         String?   @db.Text // Encrypted
  graphApiVersion   String?   @default("v20.0")
  webhookUrl        String?
  status            String    @default("MOCK_ACTIVE") // MOCK_ACTIVE | CONNECTED | DISCONNECTED | FAILED
  errorMessage      String?   @db.Text
  lastTestedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}


model AppPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("dark") // dark | light | system
  language            String   @default("en")
  timezone            String   @default("UTC")
  defaultDashboard    String   @default("overview")
  emailSignature      String?  @db.Text
  defaultAiTone       String   @default("Professional")
  autoSaveDrafts      Boolean  @default(true)
  defaultCampaignType String   @default("EMAIL")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}
